# Languages -------------------------------------------------------------------
VC_NATIVE_LANG=en          # ISO 639-1, the language the podcast is spoken in
VC_TARGET_LANG=de          # ISO 639-1, the language being taught
VC_LEVEL=A2

# Script model ----------------------------------------------------------------
# ollama | openai | anthropic | google_genai | groq | ... (anything LangChain knows)
VC_LLM_PROVIDER=ollama
VC_LLM_MODEL=qwen3:14b
# VC_LLM_BASE_URL=http://localhost:11434   # self-hosted or OpenAI-compatible
# VC_LLM_API_KEY=                          # hosted providers
VC_LLM_TEMPERATURE=0.8

# Voice model -----------------------------------------------------------------
# chatterbox (local, per-word language control) | openai | elevenlabs
VC_TTS_PROVIDER=chatterbox
# VC_TTS_MODEL=
# VC_TTS_BASE_URL=
# VC_TTS_API_KEY=
VC_TTS_DEVICE=auto         # auto | mps | cuda | cpu
VC_VOICE_A=voices/host_a.wav   # ~10s WAV for local engines, voice id for hosted ones
VC_VOICE_B=voices/host_b.wav

# Storage ---------------------------------------------------------------------
VC_DATA_DIR=~/.vocaliscast
# VC_DB_URL=postgresql+psycopg://vocaliscast:vocaliscast@localhost:5432/vocaliscast

# Episode shape ---------------------------------------------------------------
VC_NEW_WORDS=7             # new items per episode (5-10)
VC_REVIEW_WORDS=3
VC_NEW_MIN_USES=5          # uses of each new item after its explanation
VC_LEARNED_AFTER=3         # episodes featuring an item before it counts as learned
VC_EPISODE_MINUTES=10
VC_CHARS_PER_MINUTE=900    # ~250 for Chinese or Japanese
